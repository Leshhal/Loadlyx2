generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  NEW
  REVIEWED
  LOAD_CREATED
  CONVERTED
  CLOSED
}

enum LoadStatus {
  PENDING
  POSTED
  BOOKED
  COMPLETED
  CANCELED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  UNCONFIRMED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
}

enum CarrierProfileStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  ADMIN
  SUPPORT
  TENANT_ADMIN
  TENANT_STAFF
  MARKETPLACE_USER
  BROKER
  CARRIER
  STAFF
}

enum SubscriptionPlanCode {
  STARTER
  GROWTH
  PROFESSIONAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum FinancialTransactionKind {
  SAAS_SUBSCRIPTION
  STORE_SALE
  MARKETPLACE_DEAL
  REFUND
  CHARGEBACK
  ADJUSTMENT
  PAYOUT
}

enum FinancialTransactionStatus {
  PENDING
  AVAILABLE
  HELD
  SETTLED
  REVERSED
  FAILED
}

enum LedgerAccount {
  PLATFORM
  TENANT
  BROKER
  CARRIER
  PROCESSOR
  TAX_PAYABLE
  CUSTOMER
}

enum LedgerEntryType {
  SAAS_REVENUE
  STORE_COMMISSION
  MARKETPLACE_COMMISSION
  TENANT_PROCEEDS
  BROKER_MARGIN
  CARRIER_PROCEEDS
  PROCESSOR_FEE
  TAX
  REFUND
  CHARGEBACK
  ADJUSTMENT
  PAYOUT
  PAYOUT_REVERSAL
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

model Tenant {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  primaryDomain         String?                @db.VarChar(255)
  subdomain             String?                @unique @db.VarChar(63)
  isActive              Boolean                @default(true)
  isMaster              Boolean                @default(false)
  subscriptionPlan      String                 @default("free")
  brandingJson          Json?
  email                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  products              Product[]
  categories            Category[]
  quotes                Quote[]
  loads                 Load[]
  orders                Order[]
  tags                  Tag[]
  carrierProfiles       CarrierProfile[]
  users                 User[]
  commissionPolicy      CommissionPolicy?
  subscription          Subscription?
  financialTransactions FinancialTransaction[]
  ledgerEntries         LedgerEntry[]
  mediaAssets           MediaAsset[]
  themeActivation       TenantThemeActivation? @relation("ActiveTenantTheme")
  uploadedThemes        StoreTheme[]           @relation("ThemeUploaderTenant")
  reviews               Review[]
  disputes              Dispute[]
  connectionEvents      ConnectionEvent[]
  simulationConfig      SimulationConfig?
  simulationEvents      SimulationEvent[]
  aiConfig              AiTenantConfig?
  aiUsage               AiUsageEvent[]
  cryptoSettings        CryptoPaymentSettings?
  cryptoInvoices        CryptoInvoice[]
  aiAgents              AiAgentDefinition[]
  aiRecommendations     AiRecommendation[]
  approvalRequests      ApprovalRequest[]
  platformEvents        PlatformEvent[]
  workflows             WorkflowDefinition[]
  workflowRuns          WorkflowRun[]
  backgroundJobs        BackgroundJob[]
  notifications         Notification[]
  toteAssets            ToteAsset[]
  toteRentals           ToteRental[]
  inventoryLocations    InventoryLocation[]
  inventoryStocks       InventoryStock[]
  inventoryMovements    InventoryMovement[]
  digitalPasses         DigitalPass[]
  metricSnapshots       MetricSnapshot[]
  productBadges         ProductBadge[]
  shippingConfigs       TenantShippingConfig[]
  shippingQuotes        ShippingQuote[]
  securityBlocks        SecurityBlock[]
  rentalBookings        RentalBooking[]
}

enum StoreThemeStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  DISABLED
  DEPRECATED
}

enum MediaStorageProvider {
  LOCAL
  HTTP
  VERCEL_BLOB
  CLOUDINARY
  S3
  SUPABASE
}

enum ReviewTargetType {
  USER
  TENANT
  STORE
  PRODUCT
}

enum ReviewTransactionType {
  STORE_ORDER
  MARKETPLACE_LOAD
}

enum ReviewModerationStatus {
  PUBLISHED
  HIDDEN
  LOCKED
  REMOVED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

model StoreTheme {
  id                   String                  @id @default(cuid())
  key                  String                  @unique
  name                 String
  description          String?
  version              String                  @default("1.0.0")
  compatibilityVersion String                  @default("1")
  status               StoreThemeStatus        @default(DRAFT)
  isBuiltIn            Boolean                 @default(false)
  previewImageUrl      String?
  manifestJson         Json
  uploadedByTenantId   String?
  uploadedByTenant     Tenant?                 @relation("ThemeUploaderTenant", fields: [uploadedByTenantId], references: [id], onDelete: SetNull)
  activations          TenantThemeActivation[] @relation("SelectedStoreTheme")
  previousActivations  TenantThemeActivation[] @relation("PreviousStoreTheme")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([status, isBuiltIn])
  @@index([uploadedByTenantId])
}

model TenantThemeActivation {
  id              String      @id @default(cuid())
  tenantId        String      @unique
  tenant          Tenant      @relation("ActiveTenantTheme", fields: [tenantId], references: [id], onDelete: Cascade)
  themeId         String
  theme           StoreTheme  @relation("SelectedStoreTheme", fields: [themeId], references: [id], onDelete: Restrict)
  previousThemeId String?
  previousTheme   StoreTheme? @relation("PreviousStoreTheme", fields: [previousThemeId], references: [id], onDelete: SetNull)
  settingsJson    Json
  activatedAt     DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([themeId])
  @@index([previousThemeId])
}

model MediaAsset {
  id            String               @id @default(cuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider      MediaStorageProvider
  storageKey    String
  url           String
  originalName  String?
  altText       String?
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  checksum      String
  status        String               @default("READY")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  productImages ProductImage[]

  @@unique([provider, storageKey])
  @@index([tenantId, createdAt])
}

model User {
  id       String  @id @default(cuid())
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  fullName     String?
  email        String  @unique
  passwordHash String?

  role            UserRole  @default(MARKETPLACE_USER)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authTokens               AuthToken[]
  oauthAccounts            OAuthAccount[]
  reviewsWritten           Review[]             @relation("ReviewAuthor")
  reviewsReceived          Review[]             @relation("ReviewRecipient")
  reviewVotes              ReviewHelpfulVote[]
  reviewReports            ReviewReport[]
  disputesOpened           Dispute[]            @relation("DisputeOpenedBy")
  disputesAgainst          Dispute[]            @relation("DisputeAgainstUser")
  connectionEvents         ConnectionEvent[]
  marketplaceLoadsPosted   MarketplaceLoad[]    @relation("MarketplaceLoadPoster")
  marketplaceLoadsBrokered MarketplaceLoad[]    @relation("MarketplaceLoadBroker")
  marketplaceLoadsCarried  MarketplaceLoad[]    @relation("MarketplaceLoadCarrier")
  marketplaceBids          MarketplaceBid[]
  marketplaceMessages      MarketplaceMessage[]
  aiRecommendations        AiRecommendation[]
  approvalRequestsCreated  ApprovalRequest[]    @relation("ApprovalRequester")
  approvalRequestsDecided  ApprovalRequest[]    @relation("ApprovalDecider")
  notifications            Notification[]
  passkeys                 PasskeyCredential[]
  webauthnChallenges       WebAuthnChallenge[]
  digitalPasses            DigitalPass[]
  securityBlocksCreated    SecurityBlock[]      @relation("SecurityBlockCreator")

  @@index([tenantId])
  @@index([role])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  REFRESH_TOKEN
}

model AuthToken {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       AuthTokenType
  tokenHash  String        @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Category {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String?
  imageUrl     String?
  icon         String?
  displayOrder Int            @default(0)
  isEnabled    Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  products     Product[]
  badges       ProductBadge[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id                   String                   @id @default(cuid())
  tenantId             String
  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name                 String
  slug                 String
  description          String?
  longDescription      String?
  seoTitle             String?
  metaDescription      String?
  canonicalUrl         String?
  priceCents           Int
  salePriceCents       Int?
  currency             String                   @default("cad")
  productType          ProductType              @default(PHYSICAL)
  publicationStatus    ProductPublicationStatus @default(ACTIVE)
  sku                  String?
  stock                Int                      @default(0)
  weightKg             Decimal                  @db.Decimal(10, 2)
  isActive             Boolean                  @default(true)
  isFurniture          Boolean                  @default(false)
  isMovingSupply       Boolean                  @default(true)
  stripePriceId        String?
  metadataJson         Json?
  weeklyRateCents      Int?
  minimumRentalWeeks   Int?
  minimumChargeCents   Int?
  rentalInventoryUnits Int?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  orderItems           OrderItem[]
  productTags          ProductTag[]
  images               ProductImage[]
  inventoryStocks      InventoryStock[]
  inventoryMoves       InventoryMovement[]
  variants             ProductVariant[]
  collections          ProductCollectionItem[]
  badges               ProductBadge[]
  rentalBookings       RentalBooking[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([categoryId])
}

model ProductBadge {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label            String
  badgeType        String
  percentage       Int?
  startsAt         DateTime?
  endsAt           DateTime?
  enabled          Boolean   @default(true)
  displayPriority  Int       @default(0)
  tooltip          String?
  eligibilityJson  Json?
  isGlobalTemplate Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId, enabled, displayPriority])
  @@index([productId])
  @@index([categoryId])
}

model RentalBooking {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId            String
  product              Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderId              String?
  customerEmail        String
  moveDate             DateTime
  deliveryDate         DateTime
  pickupDate           DateTime
  rentalWeeks          Int
  packageQuantity      Int      @default(1)
  reservedToteUnits    Int
  weeklyRateCents      Int
  minimumChargeCents   Int
  totalCents           Int
  deliveryAddressJson  Json
  serviceArea          String?
  status               String   @default("RESERVED")
  contractSnapshotJson Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId, deliveryDate, pickupDate])
  @@index([productId, status])
  @@index([orderId])
}

enum ProductType {
  PHYSICAL
  RENTAL
  SERVICE_ADD_ON
  BUNDLE
}

enum ProductPublicationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  sku            String?
  priceCents     Int
  salePriceCents Int?
  stock          Int      @default(0)
  optionsJson    Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([productId, sku])
  @@index([productId, isActive])
}

model ProductCollection {
  id          String                  @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  products    ProductCollectionItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
}

model ProductCollectionItem {
  id           String            @id @default(cuid())
  collectionId String
  collection   ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int               @default(0)

  @@unique([collectionId, productId])
  @@index([productId])
}

model StoreCart {
  id         String          @id @default(cuid())
  tenantId   String
  userId     String?
  sessionKey String?
  currency   String          @default("cad")
  expiresAt  DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  items      StoreCartItem[]

  @@unique([tenantId, userId])
  @@unique([tenantId, sessionKey])
  @@index([expiresAt])
}

model StoreCartItem {
  id        String    @id @default(cuid())
  cartId    String
  cart      StoreCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  variantId String?
  quantity  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([cartId, productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model ProductImage {
  id        String      @id @default(cuid())
  productId String
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int         @default(0)
  assetId   String?
  asset     MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([productId])
  @@index([position])
  @@index([assetId])
}

model Review {
  id                  String                 @id @default(cuid())
  tenantId            String?
  tenant              Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  reviewerId          String
  reviewer            User                   @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeUserId      String?
  revieweeUser        User?                  @relation("ReviewRecipient", fields: [revieweeUserId], references: [id], onDelete: SetNull)
  targetType          ReviewTargetType
  targetId            String
  transactionType     ReviewTransactionType
  transactionId       String
  rating              Int
  title               String?
  body                String
  photoUrls           Json?
  verifiedTransaction Boolean                @default(false)
  moderationStatus    ReviewModerationStatus @default(PUBLISHED)
  businessResponse    String?
  responseAt          DateTime?
  lockedAt            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  helpfulVotes        ReviewHelpfulVote[]
  reports             ReviewReport[]

  @@unique([reviewerId, transactionType, transactionId, targetType, targetId])
  @@index([targetType, targetId, moderationStatus])
  @@index([revieweeUserId, moderationStatus])
  @@index([tenantId, moderationStatus])
}

model ReviewHelpfulVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([userId])
}

model ReviewReport {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
}

model Dispute {
  id              String                @id @default(cuid())
  tenantId        String?
  tenant          Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  openedByUserId  String
  openedByUser    User                  @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  againstUserId   String?
  againstUser     User?                 @relation("DisputeAgainstUser", fields: [againstUserId], references: [id], onDelete: SetNull)
  transactionType ReviewTransactionType
  transactionId   String
  reason          String
  details         String
  status          DisputeStatus         @default(OPEN)
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([openedByUserId, transactionType, transactionId])
  @@index([tenantId, status])
  @@index([status, createdAt])
}

model Tag {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  productTags ProductTag[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([tagId])
}

model Quote {
  id                      String      @id @default(cuid())
  tenantId                String
  tenant                  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fullName                String
  email                   String
  phone                   String
  address                 String?
  fromCountry             String      @default("CA")
  fromProvince            String?
  fromState               String?
  fromCity                String
  toCountry               String      @default("CA")
  toProvince              String?
  toState                 String?
  toCity                  String
  moveDate                DateTime?
  bedrooms                Int?
  estimatedWeightKg       Decimal?    @db.Decimal(10, 2)
  estimatedVolume         Decimal?    @db.Decimal(10, 2)
  comments                String?
  parsedRooms             String?
  parsedItemsJson         Json?
  parsedSuppliesJson      Json?
  recommendedProductsJson Json?
  status                  QuoteStatus @default(NEW)
  attributionSessionId    String?
  attributionReferrer     String?
  attributionLandingPage  String?
  attributionUtmSource    String?
  attributionUtmMedium    String?
  attributionUtmCampaign  String?
  attributionUtmTerm      String?
  attributionUtmContent   String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  load                    Load?

  @@index([tenantId])
  @@index([email])
  @@index([attributionUtmSource])
  @@index([attributionUtmCampaign])
}

model Load {
  id                  String     @id @default(cuid())
  tenantId            String
  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quoteId             String     @unique
  quote               Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  status              LoadStatus @default(PENDING)
  originCountry       String     @default("CA")
  originProvince      String?
  originState         String?
  originCity          String
  destinationCountry  String     @default("CA")
  destinationProvince String?
  destinationState    String?
  destinationCity     String
  pickupDate          DateTime?
  deliveryDate        DateTime?
  notes               String?
  estimatedWeightKg   Decimal?   @db.Decimal(10, 2)
  estimatedVolume     Decimal?   @db.Decimal(10, 2)
  equipmentType       String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([tenantId])
  @@index([status])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String?
  email     String
  phone     String?
  address   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email], name: "tenantId_email")
  @@index([tenantId])
}

model TenantLedger {
  id         String   @id @default(cuid())
  tenantId   String
  orderId    String   @unique
  grossCents Int
  feeCents   Int
  netCents   Int
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model CommissionPolicy {
  id                         String   @id @default(cuid())
  scopeKey                   String   @unique
  tenantId                   String?  @unique
  tenant                     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeCommissionBps         Int      @default(800)
  marketplaceCommissionBps   Int      @default(700)
  minimumMarketplaceFeeCents Int      @default(0)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Subscription {
  id                     String               @id @default(cuid())
  tenantId               String               @unique
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planCode               SubscriptionPlanCode
  status                 SubscriptionStatus   @default(TRIALING)
  monthlyPriceCents      Int
  currency               String               @default("cad")
  providerCustomerId     String?
  providerSubscriptionId String?              @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([status])
  @@index([planCode])
}

model SubscriptionPlan {
  id                  String               @id @default(cuid())
  code                SubscriptionPlanCode @unique
  name                String
  monthlyPriceCents   Int
  annualPriceCents    Int?
  currency            String               @default("cad")
  featuresJson        Json
  entitlementsJson    Json?
  displayOrder        Int                  @default(0)
  effectiveAt         DateTime             @default(now())
  grandfatherExisting Boolean              @default(true)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model FinancialTransaction {
  id                      String                     @id @default(cuid())
  idempotencyKey          String                     @unique
  tenantId                String?
  tenant                  Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  kind                    FinancialTransactionKind
  status                  FinancialTransactionStatus @default(PENDING)
  referenceType           String
  referenceId             String
  currency                String                     @default("cad")
  grossCents              Int
  taxCents                Int                        @default(0)
  discountCents           Int                        @default(0)
  processorFeeCents       Int                        @default(0)
  platformCommissionCents Int                        @default(0)
  brokerMarginCents       Int                        @default(0)
  tenantProceedsCents     Int                        @default(0)
  providerProceedsCents   Int                        @default(0)
  metadataJson            Json?
  createdAt               DateTime                   @default(now())
