  status                RecommendationStatus @default(DRAFT)
  provider              String
  model                 String
  promptTemplateKey     String?
  expiresAt             DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  approvals             ApprovalRequest[]

  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
  @@index([agentKey, createdAt])
}

model ApprovalRequest {
  id               String            @id @default(cuid())
  tenantId         String?
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recommendationId String?
  recommendation   AiRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  requestedById    String
  requestedBy      User              @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedById      String?
  decidedBy        User?             @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  actionType       String
  targetType       String
  targetId         String?
  riskLevel        AiRiskLevel
  status           ApprovalStatus    @default(PENDING)
  reason           String?
  requestedJson    Json
  decidedJson      Json?
  decidedAt        DateTime?
  expiresAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([requestedById, status])
}

model PlatformEvent {
  id             String        @id @default(cuid())
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType      String
  aggregateType  String
  aggregateId    String
  payloadJson    Json
  metadataJson   Json?
  idempotencyKey String        @unique
  correlationId  String?
  causationId    String?
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  workflowRuns   WorkflowRun[]

  @@index([tenantId, eventType, occurredAt])
  @@index([aggregateType, aggregateId])
}

model WorkflowDefinition {
  id          String        @id @default(cuid())
  scopeKey    String        @default("GLOBAL")
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  name        String
  version     Int           @default(1)
  triggerType String
  definition  Json
  enabled     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        WorkflowRun[]

  @@unique([scopeKey, key, version])
  @@index([triggerType, enabled])
}

model WorkflowRun {
  id           String             @id @default(cuid())
  tenantId     String?
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowId   String
  workflow     WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  eventId      String
  event        PlatformEvent      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  status       WorkflowRunStatus  @default(PENDING)
  currentStep  Int                @default(0)
  contextJson  Json
  resultJson   Json?
  errorCode    String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  jobs         BackgroundJob[]

  @@unique([workflowId, eventId])
  @@index([tenantId, status, createdAt])
}

model BackgroundJob {
  id             String              @id @default(cuid())
  tenantId       String?
  tenant         Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflowRunId  String?
  workflowRun    WorkflowRun?        @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  jobType        String
  queueName      String              @default("default")
  status         BackgroundJobStatus @default(QUEUED)
  payloadJson    Json
  resultJson     Json?
  idempotencyKey String              @unique
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(5)
  availableAt    DateTime            @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([queueName, status, availableAt])
  @@index([tenantId, status])
}

model Notification {
  id             String              @id @default(cuid())
  tenantId       String?
  tenant         Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  templateKey    String
  recipient      String
  subject        String?
  payloadJson    Json
  status         NotificationStatus  @default(QUEUED)
  idempotencyKey String              @unique
  providerId     String?
  failureCode    String?
  sentAt         DateTime?
  readAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([userId, readAt])
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   Json?
  name         String
  backedUp     Boolean   @default(false)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model WebAuthnChallenge {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  String    @unique
  purpose    String
  email      String?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, expiresAt])
  @@index([email, purpose, expiresAt])
}

model DigitalPass {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider       String
  passType       String
  referenceType  String
  referenceId    String
  serialNumber   String    @unique
  status         String    @default("ACTIVE")
  payloadJson    Json
  providerPassId String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([provider, referenceType, referenceId])
  @@index([tenantId, status])
}

model ToteAsset {
  id                String               @id @default(cuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  identifier        String
  qrTokenHash       String               @unique
  state             ToteState            @default(AVAILABLE)
  inventoryLocation String?
  damageNotes       String?
  reuseCount        Int                  @default(0)
  acquiredAt        DateTime             @default(now())
  retiredAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  rentalItems       ToteRentalItem[]
  events            ToteLifecycleEvent[]

  @@unique([tenantId, identifier])
  @@index([tenantId, state])
}

model ToteRental {
  id               String           @id @default(cuid())
  tenantId         String
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerUserId   String?
  customerEmail    String
  orderId          String?
  status           String           @default("RESERVED")
  deliveryDate     DateTime?
  dueDate          DateTime
  returnDate       DateTime?
  depositCents     Int              @default(0)
  replacementCents Int              @default(0)
  currency         String           @default("cad")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  items            ToteRentalItem[]

  @@index([tenantId, status, dueDate])
  @@index([customerEmail])
}

model ToteRentalItem {
  id        String     @id @default(cuid())
  rentalId  String
  rental    ToteRental @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  toteId    String
  tote      ToteAsset  @relation(fields: [toteId], references: [id], onDelete: Restrict)
  createdAt DateTime   @default(now())

  @@unique([rentalId, toteId])
  @@index([toteId])
}

model ToteLifecycleEvent {
  id           String     @id @default(cuid())
  toteId       String
  tote         ToteAsset  @relation(fields: [toteId], references: [id], onDelete: Cascade)
  actorUserId  String?
  eventType    String
  fromState    ToteState?
  toState      ToteState
  metadataJson Json?
  createdAt    DateTime   @default(now())

  @@index([toteId, createdAt])
}

model InventoryLocation {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  code            String
  addressJson     Json?
  pickupEnabled   Boolean          @default(false)
  deliveryEnabled Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  stocks          InventoryStock[]

  @@unique([tenantId, code])
}

model InventoryStock {
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId       String
  location         InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  onHand           Int               @default(0)
  reserved         Int               @default(0)
  reorderThreshold Int               @default(0)
  supplierJson     Json?
  updatedAt        DateTime          @updatedAt

  @@unique([productId, locationId])
  @@index([tenantId, onHand])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  tenantId       String
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId      String
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  locationId     String
  movementType   InventoryMovementType
  quantity       Int
  referenceType  String?
  referenceId    String?
  reason         String?
  actorUserId    String?
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())

  @@index([tenantId, productId, createdAt])
  @@index([locationId, createdAt])
}

model MetricSnapshot {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metricKey    String
  periodStart  DateTime
  periodEnd    DateTime
  value        Decimal  @db.Decimal(18, 4)
  unit         String
  sourceJson   Json
  calculatedAt DateTime @default(now())

  @@unique([tenantId, metricKey, periodStart, periodEnd])
  @@index([metricKey, periodEnd])
}
