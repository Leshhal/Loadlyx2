NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://loadlyx:change_me@localhost:5433/loadlyx
JWT_SECRET=replace_with_at_least_32_random_characters
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Durable PostgreSQL worker
WORKER_QUEUES=workflows,notifications,default
WORKER_POLL_MS=1000

# AI provider: DISABLED, MOCK, or OPENAI_COMPATIBLE
AI_PROVIDER=DISABLED
AI_API_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000

# Passkeys
PASSKEY_RP_NAME=Loadlyx
PASSKEY_RP_ID=localhost
PASSKEY_ORIGINS=http://localhost:3000

# Notifications
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_SECRET=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_SECRET=
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=cad
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=SANDBOX
CRYPTO_PROVIDER=MOCK
CRYPTO_WEBHOOK_SECRET=

# Storage and operations
MEDIA_STORAGE_PROVIDER=LOCAL
MEDIA_STORAGE_DIR=storage
MAX_IMAGE_UPLOAD_BYTES=8388608
MAPS_API_KEY=
CONNECTION_HASH_SECRET=replace_with_an_independent_random_secret
CONNECTION_RETENTION_DAYS=30

# Optional local/staging test accounts. Never set these to production user
# credentials and never commit populated values.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
TEST_TENANT_ADMIN_EMAIL=
TEST_TENANT_ADMIN_PASSWORD=
TEST_BROKER_EMAIL=
TEST_BROKER_PASSWORD=
TEST_CARRIER_EMAIL=
TEST_CARRIER_PASSWORD=
TEST_MARKETPLACE_EMAIL=
TEST_MARKETPLACE_PASSWORD=
PRODUCTION_TEST_PASSWORD=

# Digital passes (optional external providers)
DIGITAL_PASS_SIGNING_SECRET=replace_with_an_independent_random_secret
APPLE_PASS_CERTIFICATE=
GOOGLE_WALLET_CREDENTIALS=

# Existing OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
